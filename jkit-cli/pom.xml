<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.jkit</groupId>
    <artifactId>jkit-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>jkit-cli</artifactId>
  <description>picocli commands and the native binary.</description>

  <properties>
    <main.class>dev.jkit.cli.Main</main.class>
  </properties>

  <dependencies>
    <dependency>
      <groupId>dev.jkit</groupId>
      <artifactId>jkit-core</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.jkit</groupId>
      <artifactId>jkit-platform</artifactId>
    </dependency>
    <dependency>
      <groupId>info.picocli</groupId>
      <artifactId>picocli</artifactId>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <!-- jkit-version.properties gets ${project.version}; the native-image metadata is copied as is -->
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
        <includes>
          <include>jkit-version.properties</include>
        </includes>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>false</filtering>
        <excludes>
          <exclude>jkit-version.properties</exclude>
        </excludes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <!-- generates native-image reflection config for the commands -->
          <annotationProcessorPaths>
            <path>
              <groupId>info.picocli</groupId>
              <artifactId>picocli-codegen</artifactId>
              <version>${picocli.version}</version>
            </path>
          </annotationProcessorPaths>
          <compilerArgs combine.children="append">
            <arg>-Aproject=${project.groupId}/${project.artifactId}</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifest>
              <mainClass>${main.class}</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- mvn -Pnative package  (needs GRAALVM_HOME pointing at GraalVM 25) -->
    <profile>
      <id>native</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.graalvm.buildtools</groupId>
            <artifactId>native-maven-plugin</artifactId>
            <extensions>true</extensions>
            <executions>
              <execution>
                <id>build-native</id>
                <goals>
                  <goal>compile-no-fork</goal>
                </goals>
                <phase>package</phase>
              </execution>
            </executions>
            <configuration>
              <imageName>jkit</imageName>
              <mainClass>${main.class}</mainClass>
              <buildArgs>
                <buildArg>-Os</buildArg>
              </buildArgs>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <!-- Linux arch names per package format, picked from the build machine -->
    <profile>
      <id>arch-x64</id>
      <activation>
        <os><family>unix</family><arch>amd64</arch></os>
      </activation>
      <properties>
        <deb.arch>amd64</deb.arch>
        <rpm.arch>x86_64</rpm.arch>
      </properties>
    </profile>
    <profile>
      <id>arch-aarch64</id>
      <activation>
        <os><family>unix</family><arch>aarch64</arch></os>
      </activation>
      <properties>
        <deb.arch>arm64</deb.arch>
        <rpm.arch>aarch64</rpm.arch>
      </properties>
    </profile>

    <!--
      mvn -Pnative,linux-packages package   (on Linux, with GRAALVM_HOME set)
      Builds target/jkit_<version>_<arch>.deb and target/jkit-<version>-<release>.<arch>.rpm
      from the native binary. Both plugins are pure Java: no dpkg-deb or rpmbuild needed.
    -->
    <profile>
      <id>linux-packages</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.vafer</groupId>
            <artifactId>jdeb</artifactId>
            <version>${jdeb.version}</version>
            <executions>
              <execution>
                <id>deb</id>
                <phase>package</phase>
                <goals>
                  <goal>jdeb</goal>
                </goals>
                <configuration>
                  <deb>${project.build.directory}/jkit_[[version]]_${deb.arch}.deb</deb>
                  <snapshotExpand>true</snapshotExpand>
                  <controlDir>${project.basedir}/src/deb/control</controlDir>
                  <dataSet>
                    <data>
                      <src>${project.build.directory}/jkit</src>
                      <type>file</type>
                      <mapper>
                        <type>perm</type>
                        <prefix>/usr/bin</prefix>
                        <filemode>755</filemode>
                        <user>root</user>
                        <group>root</group>
                      </mapper>
                    </data>
                    <data>
                      <src>${project.basedir}/../README.md</src>
                      <type>file</type>
                      <mapper>
                        <type>perm</type>
                        <prefix>/usr/share/doc/jkit</prefix>
                        <user>root</user>
                        <group>root</group>
                      </mapper>
                    </data>
                    <data>
                      <src>${project.basedir}/src/deb/doc/copyright</src>
                      <type>file</type>
                      <mapper>
                        <type>perm</type>
                        <prefix>/usr/share/doc/jkit</prefix>
                        <user>root</user>
                        <group>root</group>
                      </mapper>
                    </data>
                  </dataSet>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>de.dentrassi.maven</groupId>
            <artifactId>rpm</artifactId>
            <version>${rpm-plugin.version}</version>
            <executions>
              <execution>
                <id>rpm</id>
                <phase>package</phase>
                <goals>
                  <goal>rpm</goal>
                </goals>
                <configuration>
                  <packageName>jkit</packageName>
                  <architecture>${rpm.arch}</architecture>
                  <summary>Installs and switches JDKs, Maven and Gradle</summary>
                  <description>jkit is a single native command-line tool that installs and switches JDKs from many vendors (Temurin, Corretto, Zulu, Liberica, GraalVM and others), Maven and Gradle. It needs no JDK to run. Enable switching in the current shell with: eval "$(jkit hook bash)"</description>
                  <license>MIT</license>
                  <group>Development/Tools</group>
                  <vendor>Adrian De Leon</vendor>
                  <packager>${package.maintainer}</packager>
                  <attach>false</attach>
                  <requires>
                    <require>
                      <name>libc.so.6(GLIBC_2.34)(64bit)</name>
                    </require>
                    <require>
                      <name>libz.so.1()(64bit)</name>
                    </require>
                  </requires>
                  <entries>
                    <entry>
                      <name>/usr/bin/jkit</name>
                      <file>${project.build.directory}/jkit</file>
                      <mode>0755</mode>
                      <user>root</user>
                      <group>root</group>
                    </entry>
                    <entry>
                      <name>/usr/share/doc/jkit/README.md</name>
                      <file>${project.basedir}/../README.md</file>
                      <documentation>true</documentation>
                      <mode>0644</mode>
                      <user>root</user>
                      <group>root</group>
                    </entry>
                    <entry>
                      <name>/usr/share/licenses/jkit/LICENSE</name>
                      <file>${project.basedir}/../LICENSE</file>
                      <license>true</license>
                      <mode>0644</mode>
                      <user>root</user>
                      <group>root</group>
                    </entry>
                  </entries>
                  <signature>
                    <skip>true</skip>
                  </signature>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
