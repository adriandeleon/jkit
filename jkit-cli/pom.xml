<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.jkit</groupId>
    <artifactId>jkit-parent</artifactId>
    <version>0.5.0-SNAPSHOT</version>
  </parent>

  <artifactId>jkit-cli</artifactId>
  <description>picocli commands and the native binary.</description>

  <properties>
    <main.class>dev.jkit.cli.Main</main.class>
    <!-- the release workflow sets 1.2.0~rc.1 for a pre-release: in RPM a "-" may not appear in
         the version, and "~" makes the pre-release sort before 1.2.0 -->
    <rpm.version>${project.version}</rpm.version>
    <!-- the same for the .deb: its control file, file name and changelog all use this -->
    <deb.version>${project.version}</deb.version>
    <!-- file times inside the jars and the .deb; the release workflow sets the tagged commit's time -->
    <project.build.outputTimestamp>2026-01-01T00:00:00Z</project.build.outputTimestamp>
  </properties>

  <dependencies>
    <dependency>
      <groupId>dev.jkit</groupId>
      <artifactId>jkit-core</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.jkit</groupId>
      <artifactId>jkit-platform</artifactId>
    </dependency>
    <dependency>
      <groupId>info.picocli</groupId>
      <artifactId>picocli</artifactId>
    </dependency>
    <!-- also on the classpath through jkit-core; declared because jkit-cli uses it itself (JsonOut).
         tomlj comes through jkit-core alone: only jkit-core reads TOML -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <!-- jkit-version.properties gets ${project.version}; the native-image metadata is copied as is -->
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
        <includes>
          <include>jkit-version.properties</include>
        </includes>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>false</filtering>
        <excludes>
          <exclude>jkit-version.properties</exclude>
        </excludes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <!-- generates native-image reflection config for the commands -->
          <annotationProcessorPaths>
            <path>
              <groupId>info.picocli</groupId>
              <artifactId>picocli-codegen</artifactId>
              <version>${picocli.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
        <executions>
          <!-- picocli-codegen reads -Aproject only for the main classes; testCompile would warn
               that no processor recognized it -->
          <execution>
            <id>default-compile</id>
            <configuration>
              <compilerArgs combine.children="append">
                <arg>-Aproject=${project.groupId}/${project.artifactId}</arg>
              </compilerArgs>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifest>
              <mainClass>${main.class}</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      mvn -Pnative package  (needs GRAALVM_HOME pointing at GraalVM 25)

      Releases are built with GraalVM Community Edition, which supports -Os (optimize for size)
      too. The SBOM shipped with a release is a separate file (CycloneDX, made in release.yml);
      Community Edition embeds none in the binary.

      With Oracle GraalVM, use package or verify with this profile, not install: the plugin makes a
      base SBOM with cyclonedx-maven-plugin, which attaches target/base_sbom.json to the project as
      an extra artifact; the plugin then embeds the SBOM in the binary and deletes that file. The
      artifact stays attached, so install fails copying a file that's gone. The binary is fine.
      <skipBaseSBOM>true</skipBaseSBOM> would avoid it, at the cost of a less detailed embedded SBOM.
    -->
    <profile>
      <id>native</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.graalvm.buildtools</groupId>
            <artifactId>native-maven-plugin</artifactId>
            <extensions>true</extensions>
            <executions>
              <execution>
                <id>build-native</id>
                <goals>
                  <goal>compile-no-fork</goal>
                </goals>
                <phase>package</phase>
              </execution>
            </executions>
            <configuration>
              <imageName>jkit</imageName>
              <mainClass>${main.class}</mainClass>
              <buildArgs>
                <buildArg>-Os</buildArg>
                <!-- the default targets x86-64-v3 (AVX2) on amd64: keep the binary running on older CPUs -->
                <buildArg>-march=compatibility</buildArg>
                <!-- HttpClient's proxy authentication (407) goes through java.net.URL with http -->
                <buildArg>--enable-url-protocols=http,https</buildArg>
                <!-- the oldest macOS the binary runs on, for the linker; native-image passes the
                     builder no environment variable it isn't told to. Unset (Linux, Windows, a
                     local build) changes nothing -->
                <buildArg>-EMACOSX_DEPLOYMENT_TARGET</buildArg>
                <!-- a native image reads -D, -X and -XX arguments as its own options, wherever they
                     are, so "jkit exec mvn -DskipTests -Xmx2g" would lose -Xmx2g and set skipTests on jkit -->
                <!-- experimental: Liberica NIK already warns that it will need unlocking -->
                <buildArg>-H:+UnlockExperimentalVMOptions</buildArg>
                <buildArg>-H:-ParseRuntimeOptions</buildArg>
                <buildArg>-H:-UnlockExperimentalVMOptions</buildArg>
              </buildArgs>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <!--
      With native: a fully static Linux binary linked against musl instead of glibc, for Alpine and
      other musl systems (it runs on glibc systems too). Needs a musl toolchain on the PATH
      (x86_64-linux-musl-gcc) with a static zlib built against it; release.yml builds both from
      source. x64 only: native-image supports musl for AMD64 alone.
    -->
    <profile>
      <id>musl</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.graalvm.buildtools</groupId>
            <artifactId>native-maven-plugin</artifactId>
            <configuration>
              <buildArgs combine.children="append">
                <buildArg>--static</buildArg>
                <buildArg>--libc=musl</buildArg>
              </buildArgs>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <!-- Linux arch names per package format, picked from the build machine -->
    <profile>
      <id>arch-x64</id>
      <activation>
        <os><family>unix</family><arch>amd64</arch></os>
      </activation>
      <properties>
        <deb.arch>amd64</deb.arch>
        <rpm.arch>x86_64</rpm.arch>
      </properties>
    </profile>
    <profile>
      <id>arch-aarch64</id>
      <activation>
        <os><family>unix</family><arch>aarch64</arch></os>
      </activation>
      <properties>
        <deb.arch>arm64</deb.arch>
        <rpm.arch>aarch64</rpm.arch>
      </properties>
    </profile>

    <!--
      mvn -Pnative,linux-packages package   (on Linux, with GRAALVM_HOME set)
      Builds target/jkit_<version>_<arch>.deb and target/jkit-<version>-<release>.<arch>.rpm
      from the native binary. Both plugins are pure Java: no dpkg-deb or rpmbuild needed.
    -->
    <profile>
      <id>linux-packages</id>
      <build>
        <plugins>
          <plugin>
            <!-- the bash completion script, written by the binary that is being packaged -->
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.7.0</version>
            <executions>
              <execution>
                <id>bash-completion</id>
                <phase>package</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>${project.build.directory}/jkit</executable>
                  <arguments>
                    <argument>completion</argument>
                    <argument>bash</argument>
                  </arguments>
                  <outputFile>${project.build.directory}/completion/jkit</outputFile>
                </configuration>
              </execution>
              <execution>
                <id>deb-changelog</id>
                <phase>package</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>${project.basedir}/../packaging/deb-changelog.sh</executable>
                  <arguments>
                    <argument>${deb.version}</argument>
                    <argument>${package.maintainer}</argument>
                    <argument>${project.build.directory}/deb-doc/changelog.gz</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.vafer</groupId>
            <artifactId>jdeb</artifactId>
            <version>${jdeb.version}</version>
            <executions>
              <execution>
                <id>deb</id>
                <phase>package</phase>
                <goals>
                  <goal>jdeb</goal>
                </goals>
                <configuration>
                  <deb>${project.build.directory}/jkit_[[deb.version]]_${deb.arch}.deb</deb>
                  <snapshotExpand>true</snapshotExpand>
                  <outputTimestamp>${project.build.outputTimestamp}</outputTimestamp>
                  <controlDir>${project.basedir}/src/deb/control</controlDir>
                  <dataSet>
                    <data>
                      <src>${project.build.directory}/jkit</src>
                      <type>file</type>
                      <mapper>
                        <type>perm</type>
                        <prefix>/usr/bin</prefix>
                        <filemode>755</filemode>
                        <user>root</user>
                        <group>root</group>
                      </mapper>
                    </data>
                    <data>
                      <src>${project.build.directory}/completion/jkit</src>
                      <type>file</type>
                      <mapper>
                        <type>perm</type>
                        <prefix>/usr/share/bash-completion/completions</prefix>
                        <filemode>644</filemode>
                        <user>root</user>
                        <group>root</group>
                      </mapper>
                    </data>
                    <data>
                      <src>${project.basedir}/../README.md</src>
                      <type>file</type>
                      <mapper>
                        <type>perm</type>
                        <prefix>/usr/share/doc/jkit</prefix>
                        <user>root</user>
                        <group>root</group>
                      </mapper>
                    </data>
                    <data>
                      <src>${project.basedir}/../THIRD-PARTY-NOTICES</src>
                      <type>file</type>
                      <mapper>
                        <type>perm</type>
                        <prefix>/usr/share/doc/jkit</prefix>
                        <user>root</user>
                        <group>root</group>
                      </mapper>
                    </data>
                    <data>
                      <src>${project.build.directory}/deb-doc/changelog.gz</src>
                      <type>file</type>
                      <mapper>
                        <type>perm</type>
                        <prefix>/usr/share/doc/jkit</prefix>
                        <filemode>644</filemode>
                        <user>root</user>
                        <group>root</group>
                      </mapper>
                    </data>
                    <data>
                      <src>${project.basedir}/src/deb/doc/copyright</src>
                      <type>file</type>
                      <mapper>
                        <type>perm</type>
                        <prefix>/usr/share/doc/jkit</prefix>
                        <user>root</user>
                        <group>root</group>
                      </mapper>
                    </data>
                  </dataSet>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>de.dentrassi.maven</groupId>
            <artifactId>rpm</artifactId>
            <version>${rpm-plugin.version}</version>
            <executions>
              <execution>
                <id>rpm</id>
                <phase>package</phase>
                <goals>
                  <goal>rpm</goal>
                </goals>
                <configuration>
                  <packageName>jkit</packageName>
                  <version>${rpm.version}</version>
                  <architecture>${rpm.arch}</architecture>
                  <summary>Installs and switches JDKs, Maven, Gradle and sbt</summary>
                  <description>jkit is a single native command-line tool that installs and switches JDKs from many vendors (Temurin, Corretto, Zulu, Liberica, GraalVM and others), Maven, Gradle and sbt. It needs no JDK to run. Set up your shell (bash, zsh or fish) with: jkit hook --install</description>
                  <!-- jkit's own code, then what is compiled in (THIRD-PARTY-NOTICES) -->
                  <license>MIT AND Apache-2.0 AND BSD-2-Clause AND BSD-3-Clause AND BSL-1.0 AND CC0-1.0 AND ICU AND MPL-2.0 AND Unicode-3.0 AND W3C AND Zlib AND GPL-2.0-only WITH Classpath-exception-2.0 AND LicenseRef-CUP AND LicenseRef-Cryptix</license>
                  <group>Development/Tools</group>
                  <vendor>Adrian De Leon</vendor>
                  <packager>${package.maintainer}</packager>
                  <!-- no runner host name in the header: the same commit gives the same rpm -->
                  <evalHostname>false</evalHostname>
                  <attach>false</attach>
                  <requires>
                    <require>
                      <name>libc.so.6(GLIBC_2.34)(64bit)</name>
                    </require>
                    <require>
                      <name>libz.so.1()(64bit)</name>
                    </require>
                    <!-- what rpmbuild declares for a version with ~ (0.3.0~rc.1): rpm 4.10 and later -->
                    <require>
                      <name>rpmlib(TildeInVersions)</name>
                      <version>4.10.0-1</version>
                      <flags>
                        <flag>RPMLIB</flag>
                        <flag>LESS</flag>
                        <flag>EQUAL</flag>
                      </flags>
                    </require>
                  </requires>
                  <entries>
                    <!-- the package owns its own folders, so removing it removes them -->
                    <entry>
                      <name>/usr/share/doc/jkit</name>
                      <directory>true</directory>
                      <mode>0755</mode>
                      <user>root</user>
                      <group>root</group>
                    </entry>
                    <entry>
                      <name>/usr/share/licenses/jkit</name>
                      <directory>true</directory>
                      <mode>0755</mode>
                      <user>root</user>
                      <group>root</group>
                    </entry>
                    <entry>
                      <name>/usr/bin/jkit</name>
                      <file>${project.build.directory}/jkit</file>
                      <mode>0755</mode>
                      <user>root</user>
                      <group>root</group>
                    </entry>
                    <entry>
                      <name>/usr/share/bash-completion/completions/jkit</name>
                      <file>${project.build.directory}/completion/jkit</file>
                      <mode>0644</mode>
                      <user>root</user>
                      <group>root</group>
                    </entry>
                    <entry>
                      <name>/usr/share/doc/jkit/README.md</name>
                      <file>${project.basedir}/../README.md</file>
                      <documentation>true</documentation>
                      <mode>0644</mode>
                      <user>root</user>
                      <group>root</group>
                    </entry>
                    <entry>
                      <name>/usr/share/licenses/jkit/LICENSE</name>
                      <file>${project.basedir}/../LICENSE</file>
                      <license>true</license>
                      <mode>0644</mode>
                      <user>root</user>
                      <group>root</group>
                    </entry>
                    <entry>
                      <!-- the libraries compiled into the binary: their licenses and NOTICE files -->
                      <name>/usr/share/licenses/jkit/THIRD-PARTY-NOTICES</name>
                      <file>${project.basedir}/../THIRD-PARTY-NOTICES</file>
                      <license>true</license>
                      <mode>0644</mode>
                      <user>root</user>
                      <group>root</group>
                    </entry>
                  </entries>
                  <signature>
                    <skip>true</skip>
                  </signature>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
