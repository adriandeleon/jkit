<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd"
         child.project.url.inherit.append.path="false">
  <modelVersion>4.0.0</modelVersion>

  <groupId>dev.jkit</groupId>
  <artifactId>jkit-parent</artifactId>
  <version>0.5.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>jkit</name>
  <description>Installs and switches JDKs, GraalVM, Maven, Gradle and sbt.</description>
  <url>https://jkit-project.dev</url>

  <licenses>
    <license>
      <name>MIT</name>
      <url>https://opensource.org/license/mit</url>
    </license>
  </licenses>

  <developers>
    <developer>
      <name>Adrian De Leon</name>
      <email>adrian.deleon@gmail.com</email>
    </developer>
  </developers>

  <scm child.scm.url.inherit.append.path="false" child.scm.connection.inherit.append.path="false"
       child.scm.developerConnection.inherit.append.path="false">
    <url>https://github.com/adriandeleon/jkit</url>
    <connection>scm:git:https://github.com/adriandeleon/jkit.git</connection>
  </scm>

  <modules>
    <module>jkit-model</module>
    <module>jkit-sources</module>
    <module>jkit-core</module>
    <module>jkit-platform</module>
    <module>jkit-cli</module>
  </modules>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <picocli.version>4.7.7</picocli.version>
    <jackson.version>2.23.0</jackson.version>
    <commons-compress.version>1.28.0</commons-compress.version>
    <tomlj.version>2.2.0</tomlj.version>
    <bouncycastle.version>1.86</bouncycastle.version>
    <junit.version>6.1.3</junit.version>
    <assertj.version>3.27.7</assertj.version>
    <maven.wrapper.version>3.10.1</maven.wrapper.version>
    <native-maven-plugin.version>1.1.19</native-maven-plugin.version>
    <jdeb.version>1.15</jdeb.version>
    <rpm-plugin.version>1.13.0</rpm-plugin.version>
    <package.maintainer>Adrian De Leon &lt;adrian.deleon@gmail.com&gt;</package.maintainer>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>dev.jkit</groupId>
        <artifactId>jkit-model</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.jkit</groupId>
        <artifactId>jkit-sources</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.jkit</groupId>
        <artifactId>jkit-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.jkit</groupId>
        <artifactId>jkit-platform</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>info.picocli</groupId>
        <artifactId>picocli</artifactId>
        <version>${picocli.version}</version>
      </dependency>
      <dependency>
        <groupId>com.fasterxml.jackson.core</groupId>
        <artifactId>jackson-databind</artifactId>
        <version>${jackson.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.commons</groupId>
        <artifactId>commons-compress</artifactId>
        <version>${commons-compress.version}</version>
      </dependency>
      <dependency>
        <groupId>org.tomlj</groupId>
        <artifactId>tomlj</artifactId>
        <version>${tomlj.version}</version>
      </dependency>
      <dependency>
        <groupId>org.bouncycastle</groupId>
        <artifactId>bcpg-jdk18on</artifactId>
        <version>${bouncycastle.version}</version>
      </dependency>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.assertj</groupId>
        <artifactId>assertj-core</artifactId>
        <version>${assertj.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <!-- every module gets the test libraries -->
  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.16.0</version>
          <configuration>
            <compilerArgs>
              <arg>-Xlint:all,-processing,-serial</arg>
            </compilerArgs>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.6.1</version>
          <configuration>
            <systemPropertyVariables>
              <!-- a home of the tests' own: jkit shows the real home as ~, and where the temp
                   folder is inside it (Windows: %USERPROFILE%\AppData\Local\Temp) every temp path
                   in its output would start with ~; nor should a test ever reach the real home -->
              <user.home>${project.build.directory}/test-home</user.home>
            </systemPropertyVariables>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.5.1</version>
        </plugin>
        <plugin>
          <groupId>org.graalvm.buildtools</groupId>
          <artifactId>native-maven-plugin</artifactId>
          <version>${native-maven-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>3.7.0</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <!-- an older JDK or Maven fails here with a clear message, not later with a compiler error -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-build-tools</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[25,)</version>
                  <message>jkit builds with JDK 25 or newer (this is ${java.version}); for example: jkit install jdk@25, then jkit use jdk@25</message>
                </requireJavaVersion>
                <requireMavenVersion>
                  <!-- the version .mvn/wrapper/maven-wrapper.properties downloads -->
                  <version>[${maven.wrapper.version},)</version>
                  <message>build with ./mvnw (Maven ${maven.wrapper.version}), not an older mvn</message>
                </requireMavenVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
